APP_NAME=SICOSA
APP_ENV=local
APP_DEBUG=true
# Pour XAMPP avec sous-dossier : APP_URL=http://localhost/sicosa
# Pour php artisan serve : APP_URL=http://localhost:8000
APP_URL=http://localhost/sicosa
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sicosa_postgis
DB_USERNAME=postgres
DB_PASSWORD=

# Redis Configuration (Cache, Queue, Session)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Cache & Session Drivers
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Broadcast (WebSockets - Laravel Reverb)
BROADCAST_DRIVER=reverb
REVERB_APP_ID=sicofil-app
REVERB_APP_KEY=sicofil-key
REVERB_APP_SECRET=sicofil-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Mobile Money (Sénégal)
WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=
WAVE_MODE=sandbox
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_TOKEN=
ORANGE_MONEY_MERCHANT_CODE=
FREE_MONEY_API_KEY=
FREE_MONEY_MERCHANT_ID=

# SMS (OTP, notifications)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Backups
# BACKUP_DISK=minio
# BACKUP_REMOTE_DIR=backups
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_CIPHER=AES-256-CBC
# BACKUP_KEEP=7
# BACKUP_RETENTION_DAYS=14
# BACKUP_DELETE_LOCAL_AFTER_UPLOAD=false
# BACKUP_ALERT_EMAIL=admin@example.com
# BACKUP_ALERT_PHONE=771234567
